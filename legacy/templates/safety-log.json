{
  "reportlog_logbook": 1,
  "title": "Safety observations",
  "slug": "safety",
  "blurb": "Something you noticed that could hurt somebody. It does not have to have gone wrong yet.",
  "accepts_files": true,
  "editorial_notes": true,
  "max_files": 2,
  "questions": [
    {
      "key": "what",
      "kind": "choice_many",
      "label": "What did you notice?",
      "help": "Tick everything that applies.",
      "required": true,
      "filterable": true,
      "options": [
        "A guard, rail or cover missing or defeated",
        "A slip, trip or fall hazard",
        "Something stored or stacked badly",
        "A vehicle or moving equipment",
        "Electrical",
        "Chemicals, fumes or dust",
        "Noise",
        "Heat, cold or weather",
        "Working at height",
        "Lone or unsupported working",
        "Fatigue or hours",
        "Pressure not to raise it",
        "Protective equipment missing or unusable",
        "Something else"
      ]
    },
    {
      "key": "where",
      "kind": "short_text",
      "label": "Where is it?",
      "required": true,
      "filterable": false
    },
    {
      "key": "when",
      "kind": "date",
      "label": "When did you notice it?",
      "required": false,
      "filterable": true
    },
    {
      "key": "still",
      "kind": "choice_one",
      "label": "Is it still like that?",
      "required": true,
      "filterable": true,
      "options": [
        "Yes, right now",
        "It comes and goes",
        "No, it has been dealt with",
        "I do not know"
      ]
    },
    {
      "key": "nearly",
      "kind": "yes_no",
      "label": "Did somebody nearly come to harm?",
      "help": "A near miss is worth recording on its own. Nothing has to have happened.",
      "required": false,
      "filterable": true
    },
    {
      "key": "told",
      "kind": "choice_one",
      "label": "Has anybody here been told already?",
      "required": false,
      "filterable": true,
      "options": [
        "No",
        "I mentioned it to somebody",
        "I reported it properly and nothing changed",
        "I do not want to raise it in person"
      ]
    },
    {
      "key": "account",
      "kind": "long_text",
      "label": "What should somebody know about it?",
      "help": "In your own words. What you saw, and what you think would fix it.",
      "required": true,
      "filterable": false
    },
    {
      "key": "has_evidence",
      "kind": "evidence_declaration",
      "label": "Do you have photos or video of it?",
      "help": "Nothing is uploaded by answering this. It only tells us something exists.",
      "required": false,
      "filterable": true
    },
    {
      "key": "evidence_of",
      "kind": "short_text",
      "label": "What is it of?",
      "required": false,
      "filterable": false,
      "shown_when": {
        "field": "has_evidence",
        "in": [
          "yes"
        ]
      }
    }
  ]
}
