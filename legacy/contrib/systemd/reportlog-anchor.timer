# Once a day, early. RandomizedDelaySec so every deployment does not hit the
# same public timestamp authority on the same second.
#
#   sudo systemctl enable --now reportlog-anchor.timer
[Unit]
Description=Anchor the ReportLog chain daily

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=20min
# If the box was off at 04:00, anchor when it comes back rather than
# skipping the day.
Persistent=true

[Install]
WantedBy=timers.target
