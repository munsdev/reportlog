# The daily chain anchor: sends the current chain head to an RFC 3161
# timestamp authority, so the archive can later be shown to have existed in
# that state at that time.
#
# Needs TSA_URL. Publishing the result needs TRANSPARENCY_LOG_DIR and a
# checkout with a remote; without those it still anchors locally.
[Unit]
Description=ReportLog daily chain anchor
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env scripts/anchor.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# read-only, NOT true. This unit pushes over ssh. A key made in the owner's
# transparency-log pane lives under the checkout's var/ and needs nothing
# from here; a key made by hand in a home directory's .ssh does, and with
# ProtectHome=true it is invisible and the push fails with "Permission denied
# (publickey)" — which reads as a rejected key and is a key never offered.
# It still cannot write anything under /home.
ProtectHome=read-only

# Two paths, and the second one is easy to miss. anchor.js writes the day's
# files into TRANSPARENCY_LOG_DIR and commits there, which is a DIFFERENT
# directory from the application. Without it the run dies on a read-only
# file system having already reached the timestamp authority.
#
# contrib/install-units.sh sets the second path from TRANSPARENCY_LOG_DIR in
# .env (or --log-dir), and creates the directory if it is missing.
ReadWritePaths=/srv/reportlog /srv/reportlog-transparency-log
