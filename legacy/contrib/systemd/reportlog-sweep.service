# TWO SWEEPS, DOING DIFFERENT THINGS, run by this one timer.
#
# It deletes expired sign-in codes, sessions, confirmation links and
# site-password tokens. Nothing depends on that for correctness — each is
# checked against its own expiry when used — but the tables otherwise grow
# forever with dead credentials.
#
# AND it erases the personal half of expired list entries, and destroys the
# day's address-hashing secrets. That half is a promise being kept: a
# deployment stating a retention period and never running this holds
# people's words indefinitely while saying it does not, and an address hash
# is only one-way once the secret it was taken under is gone.
#
# So this is optional on a deployment with no lists and NOT optional on one
# that collects. `npm run doctor` makes that distinction itself.
[Unit]
Description=ReportLog expired-row sweep and list retention
After=postgresql.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env scripts/sweep.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/reportlog
