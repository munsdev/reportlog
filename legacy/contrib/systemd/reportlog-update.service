# Apply an update the admin pane asked for.
#
# RUNS AS ROOT, and that is the point: the application is never given the
# privilege. It writes var/update-request.json naming a commit somebody
# approved; this verifies that request against the real remote and applies
# it. See contrib/update-apply.sh for the threat model.
#
# REPORTLOG_REMOTE IS THE SECURITY BOUNDARY AND IT LIVES HERE, in a file the
# application cannot write, rather than in the repository. The app can write
# its own checkout — including .git/config — so a worker that trusted the
# repository's own `origin` would be trusting the attacker. Change it here if
# you forked.
#
# AND SO DOES THE SCRIPT. ExecStart is a root-owned copy OUTSIDE the
# checkout, put there by install-units.sh. Until 10 October this ran
# /srv/reportlog/contrib/update-apply.sh directly — a file the application
# owns and can write — every minute, as root. The remote was pinned with
# care and the program reading it was left where an attacker could replace
# it, so a code-execution bug in the web app was root within a minute.
#
# A release that changes the updater is therefore applied by hand and then
# re-installed with `sudo contrib/install-units.sh`. The installed copy
# refuses such a release and says exactly that.
[Unit]
Description=ReportLog — apply a requested update
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=REPORTLOG_DIR=/srv/reportlog
Environment=REPORTLOG_USER=reportlog
Environment=REPORTLOG_SERVICE=reportlog
Environment=REPORTLOG_BRANCH=stable
Environment=REPORTLOG_REMOTE=https://github.com/munsdev/reportlog.git
ExecStart=/usr/local/libexec/reportlog/update-apply.sh

# Deliberately NOT hardened the way the app is. This restarts a service,
# installs dependencies and runs migrations; ProtectSystem=strict would stop
# all three. It is short-lived, runs only when a request file exists, and
# everything it does inside the checkout it does as the service user.
