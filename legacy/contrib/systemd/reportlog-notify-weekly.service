# The weekly digest: new published reports since each subscriber's last send,
# in one email, limited to the logbooks they follow.
#
# THIS UNIT WAS MISSING. src/digest.js, its routes and its settings pane have
# existed since logbooks shipped, and both notify scripts said "run via cron"
# while nothing in contrib installed a timer for either — so on every
# deployment that followed the install guide, nobody ever received a digest
# and nothing said so. The same shape as the anchor timer being absent from
# an instructions list, which is why both are now in EXPECTED_UNITS and the
# doctor faults their absence.
#
#   sudo systemctl enable --now reportlog-notify-weekly.timer
[Unit]
Description=ReportLog weekly digest
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env scripts/weekly-notify.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/reportlog
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
