#!/bin/bash
# One command for running a ReportLog server. Installed as
# /usr/local/bin/reportlog; run it with sudo.
#
#   reportlog deploy [ref]       deploy a branch, tag or commit
#   reportlog rollback [id]      go back to the previous release
#   reportlog releases           list releases, marking current and previous
#   reportlog doctor             check this deployment
#   reportlog backup [--check]   take a backup now (or report on them)
#   reportlog mail-test <addr>   send one real message
#   reportlog site-password      set the site password (asks twice)
#   reportlog jobs               list scheduled jobs and their schedules
#   reportlog job <name>         run one scheduled job now
#   reportlog updates            is there an update, and what would it change?
#
# Everything that runs the application's code runs as the `reportlog` user
# with the application's settings, never as root.
set -euo pipefail
# shellcheck source=../lib.sh
. /usr/local/lib/reportlog/lib.sh

[ "$(id -u)" -eq 0 ] || die "run it with sudo: sudo reportlog ${*:-help}"
cmd=${1:-help}
[ $# -gt 0 ] && shift

cli() {
  [ -e "$CURRENT" ] || die "nothing is deployed yet. Run: sudo reportlog deploy"
  [ -r "$ENV_FILE" ] || die "$ENV_FILE is missing."
  cd "$CURRENT"
  app_node apps/api/src/jobs/cli.ts "$@"
}

case "$cmd" in
  deploy) exec "$LIB/deploy.sh" "$@" ;;
  rollback) exec "$LIB/rollback.sh" "$@" ;;
  releases)
    cur=$(release_of "$CURRENT")
    prev=$(release_of "$PREVIOUS")
    for d in $(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d | sort -r); do
      mark="  "
      [ "$d" = "$cur" ] && mark="* "
      [ "$d" = "$prev" ] && mark="< "
      printf '%s%s\n' "$mark" "$(basename "$d")"
    done
    echo
    echo "* running   < previous (where 'reportlog rollback' goes)"
    ;;
  doctor) cli doctor "$@" ;;
  backup) cli run backup "$@" ;;
  mail-test) cli mail-test "$@" ;;
  site-password)
    # The setup wizard refuses to run until there is one, so a stranger who
    # finds a fresh install cannot seat themselves as its owner. Also the way
    # back in for an operator who has lost it.
    [ -e "$CURRENT" ] || die "nothing is deployed yet. Run: sudo reportlog deploy"
    cd "$CURRENT"
    app_node apps/api/src/identity/set-site-password.ts
    ;;
  jobs) cli jobs ;;
  job) cli run "$@" ;;
  updates)
    # Root fetches (it holds the repository's credentials, as a deploy
    # does); the service user reads what was found. Installs nothing.
    exec 9>/run/reportlog-deploy.lock
    if ! flock -n 9; then
      note "A deploy is running; the update check will run next time."
      exit 0
    fi
    update_check
    cli updates "$@"
    ;;
  help | -h | --help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try: reportlog help)" ;;
esac
