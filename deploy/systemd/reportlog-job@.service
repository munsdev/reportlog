# One scheduled job, by name: reportlog-job@sweep.service runs the job called
# "sweep" in apps/api/src/jobs/registry.ts. Each job's timer
# (reportlog-<job>.timer) starts it.
#
# A job that fails starts reportlog-alert@, which emails OPS_ALERT_EMAIL if
# it is set. Either way the failure shows in `systemctl list-timers`,
# `journalctl -u reportlog-job@<job>` and `reportlog doctor`.
[Unit]
Description=ReportLog job: %i
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=reportlog-alert@%n.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog/current
ExecStart=/usr/local/bin/node --env-file=/etc/reportlog/reportlog.env apps/api/src/jobs/cli.ts run %i
# A job that hangs must not hold its slot forever. The backup's drop-in
# allows longer.
TimeoutStartSec=1h
StateDirectory=reportlog
StateDirectoryMode=0750
ReadWritePaths=/var/lib/reportlog

# --- confinement ------------------------------------------------------
# The whole file system is read-only to this process except the paths in
# ReadWritePaths. The code in /srv/reportlog is owned by root, so even
# without this the service could not rewrite itself.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_UNIX for the PostgreSQL socket, INET for outbound mail and storage.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
# MemoryDenyWriteExecute is deliberately absent: V8 compiles JavaScript to
# machine code at run time and needs writable, executable memory to do it.
