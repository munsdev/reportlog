# /etc/reportlog/deploy.env: where `reportlog deploy` gets the code from.
# Installed by deploy/install.sh. Read by deploy/lib.sh, never by the
# application.

# The repository to deploy from. Fetched at deploy time only; the running
# site never contacts it.
REPO_URL=https://github.com/munsdev/reportlog.git

# What `sudo reportlog deploy` deploys when no ref is given.
DEPLOY_REF=main

# Optional. The address Caddy gives the certificate authority when it
# registers an account, for expiry warnings. Leave empty to give none.
ACME_EMAIL=

# Optional. `yes` also answers at www.<the site's domain> and sends every
# request there to the same path on the site. Set it only once the www record
# points at this server: Caddy asks for a certificate for it at the next deploy.
WWW_REDIRECT=

# Set by deploy/install-bugsink.sh: Bugsink's own domain, which every deploy
# then keeps in Caddy. Empty on a server that does not run Bugsink.
BUGSINK_DOMAIN=
