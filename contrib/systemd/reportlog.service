# The app itself.
#
#   sudo cp contrib/systemd/reportlog.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now reportlog
#
# Adjust User, Group and the two paths if you did not install to
# /srv/reportlog under a `reportlog` user.
#
# CHECK THE NODE PATH: `command -v node`. /usr/bin/node is where the
# NodeSource packages put it; a version manager (fnm, nvm, asdf) does not,
# and systemd does not read your shell profile — the service will simply
# fail to start with "No such file or directory".
[Unit]
Description=ReportLog
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
# server.js imports dotenv, so WorkingDirectory alone would find .env.
# --env-file is belt and braces and makes the unit readable on its own.
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env server.js
Restart=always
RestartSec=5

# /var/cache/reportlog, created and chowned by systemd, and shared between
# this unit and the others. It also sets CACHE_DIRECTORY, which src/mediaCache.js
# reads. Without it the media cache lands in a PrivateTmp /tmp that is
# destroyed every invocation and shared with nobody.
CacheDirectory=reportlog

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ProtectSystem=strict plus this means the app cannot write outside its own
# checkout. If you set MEDIA_CACHE_DIR to a path outside it, add that path
# here or the service fails on its first write. The default sits under the
# system temp dir, which PrivateTmp gives it privately.
ReadWritePaths=/srv/reportlog
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
