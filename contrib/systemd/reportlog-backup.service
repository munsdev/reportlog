# A verified dump of the archive, pruned to the newest few.
#
#   sudo systemctl enable --now reportlog-backup.timer
#
# Writes to BACKUP_DIR (default /var/backups/reportlog), which is OUTSIDE the
# checkout and therefore outside ProtectSystem=strict's one writable path — so
# it is named in ReadWritePaths below. Change both together if you move it.
#
# It does NOT back up .env. That file holds the only copy of two irreplaceable
# keys, and writing it beside the ciphertext it opens would turn two secrets
# into one. That copy is a human act, done once, to somewhere that is not this
# machine.
[Unit]
Description=ReportLog database backup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env scripts/backup.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Two paths: the checkout, and where the dumps go. The second is easy to miss
# and the failure is a run that dies on a read-only file system having
# already spent the time dumping.
ReadWritePaths=/srv/reportlog /var/backups/reportlog
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
