# Daily, before the anchor rather than after it.
#
# The order is deliberate: if the box is going to fall over during the night's
# scheduled work, the backup is the thing you want to have already finished.
# Anchoring can be caught up the next day; a day's reports cannot.
#
#   sudo systemctl enable --now reportlog-backup.timer
[Unit]
Description=Back up the ReportLog archive daily

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
# If the box was off at 03:30, back up when it comes back rather than
# skipping the day.
Persistent=true

[Install]
WantedBy=timers.target
