# Did the anchor run? Asks from outside the anchor, because a job that never
# starts cannot report its own silence.
#
# Reads the newest row in chain_anchors and faults when it is too old. Needs
# ADMIN_EMAIL and working mail to send the alert; it exits non-zero either
# way, so `systemctl --failed` shows it even on a deployment whose mail is
# the thing that is broken.
#
#   sudo systemctl enable --now reportlog-anchor-watch.timer
[Unit]
Description=ReportLog anchor freshness check
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=reportlog
Group=reportlog
WorkingDirectory=/srv/reportlog
ExecStart=/usr/bin/node --env-file=/srv/reportlog/.env scripts/anchor-watch.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Only the checkout. Unlike the anchor itself this writes nothing and pushes
# nowhere, so it needs neither the transparency-log directory nor the deploy
# key under the user's home.
ReadWritePaths=/srv/reportlog
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
