# Copy to .env on the server, fill in real values, chmod 600, chown edr:edr.
# Never commit the filled-in version.

DATABASE_URL=postgres://reportlog:CHANGEME@localhost:5432/reportlog
PORT=5000

# 32-byte key, base64. Generate with: openssl rand -base64 32
TIER_B_ENCRYPTION_KEY=

# Where new entries on lists that email the admin (the volunteer form is one)
# and the weekly feedback digest are sent.
#
# IT GRANTS NOTHING. Signing in with this address used to make it an
# administrator on every login; that was removed on 14 September, because
# appointing an administrator is the owner's alone and a second quieter way
# in would have hollowed that out. Administrators are managed in the app, by
# the owner.
ADMIN_EMAIL=admin@example.org

# 32-byte key, base64, for HMAC-indexing observer contact emails so
# self-service login can find "which threads belong to this email"
# without decrypting every restricted row. Keep separate from
# TIER_B_ENCRYPTION_KEY. Generate with: openssl rand -base64 32
CONTACT_HMAC_KEY=

# --- EMAIL. Not optional in practice. ---------------------------------
# With no transport configured, sendEmail() logs the subject and recipient
# and DISCARDS the body. The sign-in and setup codes alone are printed to the
# service log on purpose, so a box can be set up before mail works -- and
# nothing else: no reporter can confirm a report. A transport that is set
# and failing is worse: the code goes nowhere. Prove it works with:
#
#   npm run mail-test -- you@example.org
#
# smtp | scaleway | log. Leave empty to infer: smtp if SMTP_HOST is set,
# else scaleway if both its values are, else log. Set it to log on purpose
# for a staging box that must never send real mail.
EMAIL_TRANSPORT=

ALERT_FROM_EMAIL=alerts@example.org
ALERT_FROM_NAME=ReportLog

# SMTP -- the portable option. Works with Postmark, Mailgun, SES, Migadu,
# Fastmail, a relay you already run, or whatever your host offers.
#
# SMTP_PORT 587 is submission with STARTTLS and is what most providers
# want; 465 is implicit TLS. SMTP_SECURE is derived from the port unless
# you set it, because choosing the wrong one is the mistake people hit
# most. Leave SMTP_USER and SMTP_PASS empty for an unauthenticated local
# relay, which is a normal arrangement and not a misconfiguration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Scaleway Transactional Email (console.scaleway.com -> Transactional Email),
# as an alternative to SMTP. Domain (the part after @ in ALERT_FROM_EMAIL)
# must be registered and DNS-verified (SPF/DKIM/MX) in the Scaleway console
# before sends will work.
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_REGION=fr-par

# RFC 3161 timestamp authority for daily anchoring (DFN, Germany, no signup needed)
TSA_URL=https://zeitstempel.dfn.de

# Local checkout of the public transparency log that the daily chain-anchor
# commits are written into and pushed from. Optional; defaults to
# ~/reportlog-transparency-log for whichever account runs the cron job.
TRANSPARENCY_LOG_DIR=/srv/reportlog-transparency-log

# Which git remotes the daily anchor is pushed to, comma-separated, in the
# order they should be tried. Optional; defaults to "origin".
#
# The log is deliberately mirrored across hosts run by different operators
# in different jurisdictions. A public record held by exactly one company
# is a record that company can be ordered to take down, which would defeat
# the point of anchoring at all. Each remote is pushed independently: one
# host being unreachable is reported loudly but does not stop the others,
# and only failing to reach every one of them is treated as an error.
#
# LEAVE THIS EMPTY and list the mirrors in the owner's transparency-log
# pane, which pushes to the addresses it shows and tests. Set here, it wins
# over the pane and names remotes in the log checkout instead (what a box
# configured before the pane did):
#   git -C /srv/reportlog-transparency-log remote -v
TRANSPARENCY_LOG_REMOTES=

# Where a deployment's own documents are served from. ReportLog ships none;
# the default is the repo's own press/ directory, so documents committed
# there are published by an ordinary deploy with nothing extra to run.
# Only set this if the files live elsewhere.
# PRESS_DIR=/srv/reportlog-documents

# Feedback tracker: how many days without a status change before the weekly
# digest calls an open issue stale. Optional, defaults to 7.
FEEDBACK_STALE_DAYS=7

# Build id recorded on every bug report. Optional — normally left unset, in
# which case the checked-out git commit is used (deploys here are a git
# pull in place), falling back to package.json's version.
APP_VERSION=

# --- Attachments (Phase 1: images) ---
# Off unless this is exactly "true" AND every S3_* value below is filled in.
# With it unset the app behaves exactly as it did before attachments existed:
# /api/uploads 404s, the attach field stays hidden, and no query mentions an
# attachment table. Run `npm run migrate` and `npm run storage-smoke` before
# switching it on.
# The FALLBACK only. Attachments are switched on and off in Admin now, and
# a choice made there wins over this. This is what applies when nobody has
# pressed anything — which includes a fresh install. Either way, storage
# has to be configured below or the feature stays off regardless.
ATTACHMENTS_ENABLED=

# Hetzner Object Storage (Falkenstein fsn1, Nuremberg nbg1, Helsinki hel1 —
# all EU). Create three buckets and keep them separate: the split is what
# carries the Tier A/Tier B boundary.
#   staging    — short-lived, holds plaintext for the minutes before the
#                worker picks a file up. Set a 48h lifecycle expiry rule.
#   evidence   — encrypted originals. MUST NOT be public, ever.
#   renditions — stripped, moderator-approved files. An object landing here
#                is the publication decision.
S3_ENDPOINT=
# The location code: fsn1, nbg1 or hel1 on Hetzner — the first part of the
# endpoint's host name. NOT eu-central-1, which is AWS's name for Frankfurt.
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_STAGING=
S3_BUCKET_EVIDENCE=
S3_BUCKET_RENDITIONS=
# path (the default) or virtual. How a request names its bucket: in the path,
# host/bucket/key, or in the host name, bucket.host/key. The endpoint decides
# which it accepts, and the wrong one is a signature mismatch, not a soft
# failure. Hetzner and MinIO take path; leave it unset unless a provider
# refuses it.
S3_ADDRESSING=

# The staging bucket needs a CORS rule or the browser's direct upload is
# blocked before it starts. Hetzner's console has no CORS section, so apply
# it with the app's own credentials once the values above are filled in:
#
#   npm run storage-cors
#
# Nothing else needs a policy — every other byte is served by the app, so
# the evidence and rendition buckets are deliberately left with none.
#
# The staging bucket also needs an expiry rule, and it is not optional.
# Staging is the one bucket that holds plaintext: an upload lands there, the
# media worker encrypts it into evidence, and the staging copy is then waste
# that must not accumulate. The rule is what clears it even when the worker
# dies, a report is abandoned half-filed, or a process is killed between the
# two steps:
#
#   npm run storage-lifecycle            # show the rule on the staging bucket
#   npm run storage-lifecycle -- --apply # write it
#
# ONLY the staging bucket, and the script refuses to touch the other two even
# if this file names them there. An expiry rule on evidence or renditions
# deletes the archive on a timer.

# REQUIRED. There is no default: src/siteOrigin.js throws at boot if this is
# unset, because a wrong origin sends every reporter's confirmation link to
# somebody else's site and does it silently.
# The public origin this deployment is served from, e.g.
# https://reports.example.org — scheme included, no trailing slash.
SITE_ORIGIN=
#
# What this deployment calls itself. OPTIONAL and only a seed: an
# administrator's choice in Settings wins over it, and failing both the
# software falls back to its own name. Straight quotes mark accent runs —
# Report"Log" — and are never shown. The installer writes this key; this
# file did not list it, so anybody following CONTRIBUTING's `cp .env.example
# .env` never learned it existed.
SITE_NAME=
#
# HEIC photos and video are decoded and re-encoded rather than trimmed, so
# the worker needs two system packages on the box:
#
#   apt install ffmpeg libheif-examples
#
# Without them, JPEG/PNG/WebP still work; HEIC and video uploads are held in
# the queue (not rejected) until the packages appear, so a missing install
# can never destroy a reporter's evidence.
#
# Video limits. A phone clip at 1080p is roughly 100 MB per minute, so the
# defaults allow about a minute and a half of footage.
MAX_VIDEO_BYTES=
# Audio and PDF, both added in MK 0.0.30. A document is capped by pages as
# well as bytes: a small PDF can still be nine hundred pages, and every page
# becomes an image to render, store and look at.
MAX_AUDIO_BYTES=
MAX_DOCUMENT_BYTES=
MAX_DOCUMENT_PAGES=
MAX_VIDEO_SECONDS=
# Total across all files on one report. Defaults to 400 MB.
MAX_TOTAL_BYTES=
# How long a single transcode may run before it is killed. Defaults to 5 min.
MEDIA_TRANSCODE_TIMEOUT_MS=

# ClamAV for uploaded files. Optional, and fails closed: if it is switched on
# but clamdscan is unavailable, files are left unprocessed rather than passed
# through unscanned.
CLAMAV_ENABLED=

# Published photos and video are cached on this box after their first view,
# so repeated viewing does not repeatedly pull them out of object storage
# (and so scrubbing a video is a disk read rather than a request per seek).
#
# The publication gate still runs on every single request — only the bytes
# are local — so withdrawing or erasing a file takes effect immediately.
# Originals are never cached: those views are audited and unpublished.
#
# Capped at 2 GB, with least-recently-used eviction. Set
# MEDIA_CACHE_ENABLED=false to turn it off entirely (everything still works,
# just with more bucket traffic).
#
# LEAVE MEDIA_CACHE_DIR EMPTY IF YOU USE THE SHIPPED SYSTEMD UNITS. They
# declare CacheDirectory=reportlog, so systemd creates /var/cache/reportlog,
# chowns it, and passes it as CACHE_DIRECTORY, which is what the cache uses.
#
# Set it only if you run some other way. The last-resort fallback is a
# directory under the system temp dir, which is WRONG under systemd: a unit
# with PrivateTmp=true gets a private /tmp destroyed at the end of the
# invocation, so the worker's cache is thrown away every minute and the
# application never sees it. Nothing breaks; the cache just does nothing.
MEDIA_CACHE_DIR=
MEDIA_CACHE_MAX_BYTES=
MEDIA_CACHE_ENABLED=

# How many files one media-worker pass handles. Optional, defaults to 20.
MEDIA_WORKER_BATCH=

# --- intake hardening --------------------------------------------------
#
# HOW MUCH ONE EMAIL ADDRESS MAY HAVE STAGED AT ONCE, counted in reports'
# worth of MAX_TOTAL_BYTES. Optional, defaults to 3.
#
# The per-report limits above bound one report. They could be walked around,
# because a draft token is free — the form asks for one before anybody has
# proved anything — so somebody could open as many drafts as they liked. This
# is the ceiling across every draft one address has open, and it is why the
# form asks for the address before the files on a logbook that takes them.
#
# The address is unverified at that point and this does not pretend
# otherwise: it raises the cost of parking bytes, it does not identify
# anybody. Only a keyed digest of it is stored on the staging row.
#
# Raise it if real reporters are being turned away; 0 switches it off. A
# refused second report is a far worse failure than some wasted staging, so
# the default is deliberately generous.
STAGING_QUOTA_REPORTS=

# HOW LONG A CONFIRMATION WAITS for files that are still being prepared
# before it goes ahead without them. Optional, defaults to 30 minutes.
#
# Nothing is transcoded while somebody fills the form in — the worker starts
# when they press Send — so a reporter who clicks their confirmation link
# quickly can arrive before their video is ready. Confirming is the last
# moment the file can join the report, so the page waits and then goes ahead,
# naming anything that did not make it.
#
# KEEP IT LONGER THAN MEDIA_WORKER_STALE_MINUTES (15). An interrupted
# transcode is requeued at that mark, so a wait that gave up sooner would
# give up exactly as the retry began. The suite checks this.
CONFIRM_WAIT_MS=

# How long a claimed upload may sit unfinished before the worker assumes the
# attempt died and requeues it. Optional, defaults to 15 minutes.
MEDIA_WORKER_STALE_MINUTES=

# --- backups -----------------------------------------------------------
#
# `npm run backup` takes a pg_dump, reads it back with pg_restore --list
# before giving it its real name, and prunes to the newest BACKUP_KEEP. The
# shipped reportlog-backup.timer runs it daily, and `npm run doctor` reports
# a problem when the newest dump is older than BACKUP_MAX_AGE_HOURS — which
# is the half that matters, because a backup that quietly stopped looks
# exactly like one that is working.
#
# THIS ARCHIVE CANNOT DELETE A ROW BY DESIGN. That protects the record from
# being edited and not at all from the disk dying.
#
# BACKUP_DIR must be OUTSIDE the checkout and the script refuses otherwise: a
# dump under the application directory is a copy of the whole archive sitting
# where git will offer to commit it, and under public/ nginx would serve it
# to anybody who guessed the name. If you change it, change ReadWritePaths in
# contrib/systemd/reportlog-backup.service with it.
#
# WHAT THIS DOES NOT BACK UP: .env. Writing it here would put the only copy
# of the two encryption keys beside the ciphertext they open, on the same
# disk. That copy is a human act, done once, to somewhere that is not this
# machine. See INSTALL.md §3.8.
#
# Defaults: /var/backups/reportlog, keep 14, stale after 48 hours.
BACKUP_DIR=
BACKUP_KEEP=
BACKUP_MAX_AGE_HOURS=

# --- updates -----------------------------------------------------------
# The branch the Updates pane compares this deployment against. Unset means
# stable, which is what INSTALL.md clones. Set it only if you installed from
# another branch — and then set the SAME value as Environment=REPORTLOG_BRANCH
# in reportlog-update.service, because the pane reads it from here and the
# updater root runs reads it from the unit. If the two disagree, the pane
# offers a commit the updater refuses.
REPORTLOG_BRANCH=

# ---------------------------------------------------------------------------
# LISTS — the second format, beside logbooks.
#
# A FORM IS THE QUESTION SET. LOGBOOK OR LIST IS WHAT HAPPENS TO THE
# ANSWERS. A logbook seals, chains, is append-only and permanent, and
# publishes nothing until a moderator approves it one by one. A list seals
# nothing, keeps an editable form, erases the personal half of its entries
# on a timer, is approved in bulk, and publishes counts rather than content.
#
# Three templates ship: the Tip List, check-ins, and a contact form. They
# differ only by their questions — nothing in the code asks which template
# a list came from.
#
# RETENTION HERE BELONGS TO A FIELD, NOT TO A ROW. An entry is two kinds of
# record glued together: a link points at public material and is a record
# about the world, while free text, an email and a hashed address are
# records about people. The two halves are stored in two different COLUMNS,
# so the sweep empties one and leaves the other — the links stay, the text
# and the contact details go — and a count physically cannot reach anything
# erasable.
#
# How many days the erasable half of a list entry is kept. The whole row
# survives either way; this governs free-text answers, the email and the
# hashed address.
#
# A RETENTION PERIOD APPLIES FORWARD ONLY. Each row stores the expiry it was
# written with, so changing this changes what the next entry gets and
# nothing about the last one.
#
# `never` keeps the erasable half indefinitely, which is only honest on a
# form that requires an address — there has to be a way to reach somebody
# whose data you are keeping and a route for them to take it back. The
# module refuses the other combination rather than trusting an operator to
# notice.
#
# An unparseable or non-positive value falls back to the default rather than
# meaning `never`: a typo must not be able to turn retention off, because
# that failure is invisible and the data it keeps is the heaviest here.
#
# Default: 90. Ninety days keeps election material into late January; thirty
# does not.
LIST_PERSONAL_DAYS=

# How many days a day's address-hashing secret is kept before it is
# destroyed.
#
# The raw address is never written. What is stored is an HMAC under a random
# 32-byte secret generated fresh each UTC day — not a plain salted hash,
# because the IPv4 space is 2^32 and anybody holding the table and the salt
# could enumerate it. DESTROYING THE SECRET IS WHAT MAKES THE HASH ONE-WAY:
# once the row is gone, every hash taken under it is permanently
# uncorrelatable.
#
# Two days rather than one, so a rate limit that looks back twenty-four
# hours still has yesterday's secret at one minute past midnight. Longer is
# the only cost that matters: every extra day is a day in which a hash is
# still correlatable.
#
# Default: 2.
LIST_SALT_DAYS=

# How long an erasure link stays valid, for the case where nothing expires
# on its own.
#
# Normally a link lives exactly as long as the data it can erase, following
# the entry's own expiry — a link that died first would leave somebody
# holding a promise this deployment had stopped being able to keep. This
# applies only where the erasable half is durable, where there is no expiry
# to follow and the link is the only route there is.
#
# Default: 365.
LIST_ERASURE_LINK_DAYS=

# Sites a moderator reviewing list entries will recognise, comma-separated —
# e.g. youtube.com,facebook.com,local-paper.example. A link to anywhere else
# is marked "unfamiliar" on the Moderators page. It SORTS, never blocks:
# nothing is refused for coming from a site not on this list.
#
# Default: empty, so every site is marked unfamiliar.
LIST_KNOWN_HOSTS=
