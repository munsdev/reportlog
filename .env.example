# Copy to .env for local development. Nothing here is a real secret.
DATABASE_URL=postgres://postgres@localhost:5432/reportlog_dev
# The database the test suite creates throwaway databases beside.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
PORT=3000
PUBLIC_REF_PREFIX=RL-
# The key reporters' addresses are encrypted under (32 random bytes, base64:
# openssl rand -base64 32). Without it the site takes no reports. Never change
# it on a running archive: every stored address would become unreadable.
CONTACT_KEY=
