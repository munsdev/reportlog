# Copy to .env for local development. Nothing here is a real secret.
DATABASE_URL=postgres://postgres@localhost:5432/reportlog_dev
# The database the test suite creates throwaway databases beside.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
PORT=3000
PUBLIC_REF_PREFIX=RL-
# The key reporters' addresses are encrypted under (32 random bytes, base64:
# openssl rand -base64 32). Without it the site takes no reports. Never change
# it on a running archive: every stored address would become unreadable.
CONTACT_KEY=
# Files (photos, video, audio, documents). The key each file's own key is
# wrapped under: 32 random bytes, base64, and NOT the same as CONTACT_KEY.
# Never change it on a running archive. Without it no file is taken.
FILES_KEY=
# disk (development) or s3 (production: any S3-compatible storage in the EU).
FILES_STORAGE=disk
FILES_DIR=.files
# Development only: run the media worker inside the server.
FILES_INLINE_WORKER=true
# For FILES_STORAGE=s3:
# S3_ENDPOINT=https://...
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_STAGING=
# S3_BUCKET_EVIDENCE=
# S3_BUCKET_RENDITIONS=
# S3_ADDRESSING=path
