# Every setting ReportLog reads, with placeholder values. Nothing here is a
# real secret, and nothing real belongs in this file: it is committed.
#
# Development: copy to .env and adjust the first block.
# A server: deploy/install.sh copies this to /etc/reportlog/reportlog.env
# (root:reportlog, mode 0640) with DATABASE_URL filled in; you fill in the
# rest there. apps/api/src/config.ts checks every value at start and names
# anything wrong, and `sudo reportlog doctor` says what is still missing.
#
# A setting left empty (KEY=) counts as not set. Lines starting `# KEY=`
# show a placeholder; remove the `# ` and put the real value in.

# --- the server ---------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5432/reportlog_dev
# The database the test suite creates throwaway databases beside. Not used
# on a server.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# Where the API listens. Keep 127.0.0.1 on a server: Caddy is the only thing
# in front of it.
HOST=127.0.0.1
PORT=3000
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# The prefix of every public reference (RL-1234). Sealed into every report,
# so it is chosen once and never changed.
PUBLIC_REF_PREFIX=RL-
# The address people reach the site at. Every link in every email is built
# from it, and Caddy gets its certificate for this domain.
# SITE_ORIGIN=https://reports.example.org

# --- email ----------------------------------------------------------------------
# off: send nothing (the default; the doctor fails a server left on it).
# scaleway: send through Scaleway Transactional Email.
# capture: keep messages for tests, written to EMAIL_CAPTURE_DIR if set.
EMAIL_TRANSPORT=off
# The sender. Must be on a domain verified in Scaleway, with SPF, DKIM and
# DMARC records published, or mail is accepted and then filed as junk.
# EMAIL_FROM_ADDRESS=reports@example.org
# EMAIL_FROM_NAME=Example Reports
# Only for EMAIL_TRANSPORT=capture: a directory a browser test reads.
EMAIL_CAPTURE_DIR=
# From the Scaleway console: an API key with Transactional Email permission
# (IAM), and the project the sending domain belongs to.
# SCALEWAY_SECRET_KEY=00000000-0000-0000-0000-000000000000
# SCALEWAY_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Transactional Email is served from Paris.
SCALEWAY_REGION=fr-par
# Who is emailed when a scheduled job fails. Leave empty and only the doctor
# will tell you.
# OPS_ALERT_EMAIL=ops@example.org

# --- backups ----------------------------------------------------------------------
# Local dumps: where, how many to keep, and how old the newest may be before
# the doctor calls it a failure.
BACKUP_DIR=/var/backups/reportlog
BACKUP_KEEP=14
BACKUP_MAX_AGE_HOURS=48
# Where jobs record what they last did, for the doctor.
STATE_DIR=/var/lib/reportlog
# Off-site copies are encrypted to these age public keys before they leave
# the server (make one with `age-keygen` on a machine that is NOT the
# server, and keep the private key there and somewhere safe). Space or comma
# separated, so a second person's key can be added.
# BACKUP_AGE_RECIPIENTS=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
# S3-compatible object storage in the EU, e.g. Hetzner Object Storage
# (https://fsn1.your-objectstorage.com, region fsn1) or Scaleway Object
# Storage (https://s3.nl-ams.scw.cloud, region nl-ams). Give the key
# permission to upload and nothing else, and expire old copies with the
# bucket's lifecycle rules (deploy/README.md). All five, or none.
# BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# BACKUP_S3_REGION=fsn1
# BACKUP_S3_BUCKET=example-reportlog-backups
BACKUP_S3_PREFIX=reportlog/
# BACKUP_S3_ACCESS_KEY_ID=EXAMPLEACCESSKEY
# BACKUP_S3_SECRET_ACCESS_KEY=example-secret-key
