{
  "reportlog_logbook": 1,
  "title": "Election incidents",
  "slug": "election-incidents",
  "blurb": "Something went wrong at a polling place, or around one. Say what happened.",
  "accepts_files": true,
  "editorial_notes": true,
  "max_files": 1,
  "max_total_bytes": 314572800,
  "questions": [
    {
      "key": "what",
      "kind": "choice_many",
      "label": "What happened?",
      "help": "Tick everything that applies.",
      "required": true,
      "filterable": true,
      "options": [
        "Voter turned away or denied a ballot",
        "ID improperly demanded or refused",
        "Language or disability access denied",
        "Long lines or wait times",
        "Late opening or early closing",
        "Equipment failure or shortage",
        "Insufficient or untrained staff",
        "Voter or worker intimidation",
        "Improper challenge of voters",
        "Armed or uniformed presence",
        "Law enforcement involvement",
        "Disinformation at the site",
        "Observer access denied or restricted",
        "Observer expelled",
        "Ballot secrecy or handling issue",
        "Count not observable",
        "Results or certification irregularity",
        "Something else"
      ]
    },
    {
      "key": "state",
      "kind": "place",
      "label": "Which state was it in?",
      "required": true,
      "filterable": true,
      "options": [
        "Alabama",
        "Alaska",
        "Arizona",
        "Arkansas",
        "California",
        "Colorado",
        "Connecticut",
        "Delaware",
        "District of Columbia",
        "Florida",
        "Georgia",
        "Hawaii",
        "Idaho",
        "Illinois",
        "Indiana",
        "Iowa",
        "Kansas",
        "Kentucky",
        "Louisiana",
        "Maine",
        "Maryland",
        "Massachusetts",
        "Michigan",
        "Minnesota",
        "Mississippi",
        "Missouri",
        "Montana",
        "Nebraska",
        "Nevada",
        "New Hampshire",
        "New Jersey",
        "New Mexico",
        "New York",
        "North Carolina",
        "North Dakota",
        "Ohio",
        "Oklahoma",
        "Oregon",
        "Pennsylvania",
        "Puerto Rico",
        "Rhode Island",
        "South Carolina",
        "South Dakota",
        "Tennessee",
        "Texas",
        "Utah",
        "Vermont",
        "Virginia",
        "Washington",
        "West Virginia",
        "Wisconsin",
        "Wyoming"
      ],
      "allow_other": false
    },
    {
      "key": "place",
      "kind": "short_text",
      "label": "Where exactly?",
      "help": "The polling place, the street, or as near as you can say.",
      "required": false,
      "filterable": false
    },
    {
      "key": "date",
      "kind": "date",
      "label": "What day was it?",
      "required": true,
      "filterable": true
    },
    {
      "key": "time",
      "kind": "time",
      "label": "About what time?",
      "required": false,
      "filterable": false
    },
    {
      "key": "role",
      "kind": "choice_one",
      "label": "What was your role?",
      "required": true,
      "filterable": true,
      "options": [
        "A voter",
        "A poll worker",
        "An observer",
        "An election official",
        "Something else"
      ]
    },
    {
      "key": "saw",
      "kind": "choice_one",
      "label": "Did you see it yourself?",
      "required": true,
      "filterable": true,
      "options": ["I saw it myself", "Someone told me about it", "I saw it online or in the news"]
    },
    {
      "key": "account",
      "kind": "long_text",
      "label": "Tell us what happened",
      "help": "In your own words. What you saw, who was involved, what happened next.",
      "required": true,
      "filterable": false
    },
    {
      "key": "has_evidence",
      "kind": "evidence_declaration",
      "label": "Do you have photos, video, audio or documents of this?",
      "help": "Nothing is uploaded by answering this. It only tells us something exists, so we can ask you for it if it turns out to matter.",
      "required": false,
      "filterable": true
    },
    {
      "key": "evidence_of",
      "kind": "short_text",
      "label": "What is it of?",
      "help": "One line. 'Thirty seconds of the queue outside', or 'a photo of the notice on the door'.",
      "required": false,
      "filterable": false,
      "shown_when": {
        "field": "has_evidence",
        "in": ["yes"]
      }
    }
  ]
}
