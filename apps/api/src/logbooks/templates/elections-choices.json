{
  "reportlog_logbook": 1,
  "title": "Election day: how did it go?",
  "slug": "election-day",
  "blurb": "Voted, worked a polling place or watched one? Say how it went, fine or not, with nothing to type.",
  "accepts_files": false,
  "editorial_notes": true,
  "questions": [
    {
      "key": "outcome",
      "kind": "choice_one",
      "label": "How did it go?",
      "help": "Reports that went fine matter too: they are what makes a count of problems mean something.",
      "required": true,
      "filterable": true,
      "options": ["It went fine", "Something went wrong"]
    },
    {
      "key": "role",
      "kind": "choice_one",
      "label": "What was your role?",
      "required": true,
      "filterable": true,
      "options": [
        "A voter",
        "A poll worker",
        "An observer",
        "An election official",
        "Something else"
      ]
    },
    {
      "key": "method",
      "kind": "choice_one",
      "label": "How was the voting being done?",
      "required": true,
      "filterable": true,
      "options": [
        "In person, on Election Day",
        "In person, early voting",
        "By mail",
        "At a drop box"
      ]
    },
    {
      "key": "state",
      "kind": "place",
      "label": "Which state?",
      "required": true,
      "filterable": true,
      "options": [
        "Alabama",
        "Alaska",
        "Arizona",
        "Arkansas",
        "California",
        "Colorado",
        "Connecticut",
        "Delaware",
        "District of Columbia",
        "Florida",
        "Georgia",
        "Hawaii",
        "Idaho",
        "Illinois",
        "Indiana",
        "Iowa",
        "Kansas",
        "Kentucky",
        "Louisiana",
        "Maine",
        "Maryland",
        "Massachusetts",
        "Michigan",
        "Minnesota",
        "Mississippi",
        "Missouri",
        "Montana",
        "Nebraska",
        "Nevada",
        "New Hampshire",
        "New Jersey",
        "New Mexico",
        "New York",
        "North Carolina",
        "North Dakota",
        "Ohio",
        "Oklahoma",
        "Oregon",
        "Pennsylvania",
        "Puerto Rico",
        "Rhode Island",
        "South Carolina",
        "South Dakota",
        "Tennessee",
        "Texas",
        "Utah",
        "Vermont",
        "Virginia",
        "Washington",
        "West Virginia",
        "Wisconsin",
        "Wyoming"
      ],
      "allow_other": false
    },
    {
      "key": "date",
      "kind": "date",
      "label": "What day was it?",
      "required": true,
      "filterable": true
    },
    {
      "key": "time_of_day",
      "kind": "choice_one",
      "label": "What time of day?",
      "required": true,
      "filterable": true,
      "options": ["At opening", "Morning", "Around midday", "Afternoon", "Evening", "At closing"]
    },
    {
      "key": "what",
      "kind": "choice_many",
      "label": "If something went wrong, what?",
      "help": "Leave this empty if it went fine.",
      "required": false,
      "filterable": true,
      "options": [
        "Voter turned away or denied a ballot",
        "ID improperly demanded or refused",
        "Language or disability access denied",
        "Long lines or wait times",
        "Late opening or early closing",
        "Equipment failure or shortage",
        "Insufficient or untrained staff",
        "Voter or worker intimidation",
        "Improper challenge of voters",
        "Armed or uniformed presence",
        "Law enforcement involvement",
        "Disinformation at the site",
        "Observer access denied or restricted",
        "Observer expelled",
        "Ballot secrecy or handling issue",
        "Count not observable",
        "Results or certification irregularity",
        "Something else"
      ]
    },
    {
      "key": "impact",
      "kind": "choice_one",
      "label": "What did it mean for the voter?",
      "help": "Only if something went wrong.",
      "required": false,
      "filterable": true,
      "options": [
        "Voted normally in the end",
        "Voted with a provisional ballot",
        "Voted, but was held up badly",
        "Did not vote",
        "Not sure"
      ]
    },
    {
      "key": "resolved",
      "kind": "choice_one",
      "label": "Was it sorted out on the spot?",
      "help": "Only if something went wrong.",
      "required": false,
      "filterable": true,
      "options": ["Yes", "No", "Not sure"]
    }
  ]
