.env
*.env
!.env.example
node_modules/
*.log
tools/browser-tests/node_modules

# Personal Claude Code permission allowlist. The shared config —
# .claude/settings.json, which carries the session-start hook — is committed.
.claude/settings.local.json

# Generated and generatable: the update queue the root worker consumes, and
# the one-file install handout `tools/make-handout.mjs` builds from
# public/docs.html. Committing either would be committing a stale copy of
# something the repository already holds the source of.
var/

# Generated site builds. `npm run docs:site` rebuilds dist/docs-site from
# public/docs.html; committing it would commit a stale copy of something the
# repository already holds the source of.
dist/

# A stored git credential, on a deployment that clones a private repository.
# The service user's home IS the checkout (adduser --home), so these land
# here rather than somewhere else. Ignored for two reasons: `git status` on
# such a box is otherwise permanently noisy, and `git add -A` must never be
# able to commit somebody's token.
.gitconfig
.git-credentials
